# ========================================================
# Spartan Impax Portfolio - Environment Variables Template
# ========================================================

# 1. PostgreSQL Database via Prisma (Required)
DATABASE_URL="postgres://username:password@host:5432/database?sslmode=require"

# 2. Razorpay Payment Gateway Credentials (Required for Payments)
# Get from Razorpay Dashboard -> Settings -> API Keys
# Use 'rzp_test_...' for testing or 'rzp_live_...' for production
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# Optional: Razorpay Webhook Secret (from Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_here"

# 3. Security & Admin Authentication
PORT=5000
NODE_ENV=production
JWT_SECRET="spartan_impax_jwt_super_secret_2026"
ADMIN_EMAIL="gajender@spartanimpex.com"
ADMIN_PASSWORD="your_secure_admin_password"
